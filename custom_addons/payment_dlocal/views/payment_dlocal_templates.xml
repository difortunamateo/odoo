<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="redirect_form">
        <form t-att-action="api_url" method="post" name="dlocal_form" id="dlocal_form">
            <input type="hidden" name="currency" t-att-value="tx_values.get('currency')"/>
            <input type="hidden" name="amount" t-att-value="tx_values.get('amount')"/>
            <input type="hidden" name="country" t-att-value="tx_values.get('country')"/>
            <input type="hidden" name="order_id" t-att-value="tx_values.get('order_id')"/>
            <input type="hidden" name="description" t-att-value="tx_values.get('description')"/>
            <input type="hidden" name="success_url" t-att-value="tx_values.get('success_url')"/>
            <input type="hidden" name="back_url" t-att-value="tx_values.get('back_url')"/>
            <input type="hidden" name="notification_url" t-att-value="tx_values.get('notification_url')"/>

            <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
                <div class="text-center">
                    <h2>Bernie, redirigiéndote a dLocal...</h2>
                    <p>Por favor espera un momento.</p>
                    <div class="spinner-border text-primary" role="status">
                        <span class="sr-only">Cargando...</span>
                    </div>
                </div>
            </div>
        </form>
    </template>
</odoo>
