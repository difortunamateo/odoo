<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_transaction_form_dlocal" model="ir.ui.view">
        <field name="name">DLocal Transaction Form</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <field name="provider_reference" position="after">
                <field name="x_dlocal_status"
                       readonly="1"
                       invisible="provider_code != 'dlocal'"/>
                <field name="x_dlocal_reference"
                       readonly="1"
                       invisible="provider_code != 'dlocal'"/>
                <field name="x_dlocal_payment_method"
                       readonly="1"
                       invisible="provider_code != 'dlocal'"/>
            </field>
        </field>
    </record>

</odoo>
